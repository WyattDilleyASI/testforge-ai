# TestForge AI - Environment Configuration

# Server
PORT=3000

# Session & Security
SESSION_SECRET=change-this-in-production-with-a-strong-random-secret

# Database
DB_PATH=./data/testforge.db

# Anthropic API (Required for AI test case generation)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
 

# Model selection (optional, defaults to claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514


TOKEN_BUDGET=500000
